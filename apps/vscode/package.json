{
  "name": "diffpanel-vscode",
  "private": true,
  "displayName": "Diffpanel",
  "description": "Browse persistent, agent-generated repository review chapters.",
  "version": "0.1.0",
  "publisher": "21nCo",
  "license": "UNLICENSED",
  "files": [
    "CHANGELOG.md",
    "dist/**",
    "media/**"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": ["SCM Providers", "Other"],
  "keywords": ["review", "diff", "chapters", "cursor", "codex", "claude"],
  "icon": "media/diffpanel-icon.png",
  "extensionKind": ["workspace"],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:diffpanel.reviews",
    "onView:diffpanel.details",
    "onCommand:diffpanel.refresh",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "diffpanel.refresh",
        "title": "Refresh Reviews",
        "category": "Diffpanel",
        "icon": "$(refresh)"
      },
      {
        "command": "diffpanel.openRun",
        "title": "Open Review",
        "category": "Diffpanel"
      },
      {
        "command": "diffpanel.openItem",
        "title": "Open Review Item",
        "category": "Diffpanel"
      },
      {
        "command": "diffpanel.openWorkingFile",
        "title": "Open Working File",
        "category": "Diffpanel",
        "icon": "$(go-to-file)"
      },
      {
        "command": "diffpanel.copySkillPrompt",
        "title": "Copy Generation Prompt",
        "category": "Diffpanel",
        "icon": "$(copy)"
      },
      {
        "command": "diffpanel.showArchivedReviews",
        "title": "Show Archived Reviews",
        "category": "Diffpanel",
        "icon": "$(archive)"
      },
      {
        "command": "diffpanel.hideArchivedReviews",
        "title": "Hide Archived Reviews",
        "category": "Diffpanel",
        "icon": "$(eye-closed)"
      },
      {
        "command": "diffpanel.archiveReview",
        "title": "Archive Review",
        "category": "Diffpanel",
        "icon": "$(archive)"
      },
      {
        "command": "diffpanel.unarchiveReview",
        "title": "Restore Archived Review",
        "category": "Diffpanel",
        "icon": "$(discard)"
      },
      {
        "command": "diffpanel.renameReview",
        "title": "Rename Review",
        "category": "Diffpanel"
      }
    ],
    "configuration": {
      "title": "Diffpanel",
      "properties": {
        "diffpanel.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Diffpanel CLI executable or built index.js. Empty uses the bundled development CLI when present, then diffpanel on PATH."
        },
        "diffpanel.nodePath": {
          "type": "string",
          "default": "",
          "description": "Optional Node.js executable used when the Diffpanel CLI is a JavaScript file or a symlink to one. Empty checks common installation paths."
        },
        "diffpanel.home": {
          "type": "string",
          "default": "",
          "description": "Optional Diffpanel data directory. Equivalent to DIFFPANEL_HOME."
        },
        "diffpanel.refreshIntervalSeconds": {
          "type": "number",
          "default": 4,
          "minimum": 2,
          "maximum": 60,
          "description": "How often the review library checks for skill-generated runs."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "diffpanel",
          "title": "Diffpanel",
          "icon": "media/diffpanel.svg"
        }
      ]
    },
    "views": {
      "diffpanel": [
        {
          "id": "diffpanel.reviews",
          "name": "Reviews"
        },
        {
          "id": "diffpanel.details",
          "name": "Review Details",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "diffpanel.refresh",
          "when": "view == diffpanel.reviews",
          "group": "navigation"
        },
        {
          "command": "diffpanel.copySkillPrompt",
          "when": "view == diffpanel.reviews",
          "group": "navigation"
        },
        {
          "command": "diffpanel.showArchivedReviews",
          "when": "view == diffpanel.reviews && !diffpanel.showingArchived",
          "group": "navigation"
        },
        {
          "command": "diffpanel.hideArchivedReviews",
          "when": "view == diffpanel.reviews && diffpanel.showingArchived",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "diffpanel.archiveReview",
          "when": "view == diffpanel.reviews && viewItem == diffpanelRun",
          "group": "inline"
        },
        {
          "command": "diffpanel.unarchiveReview",
          "when": "view == diffpanel.reviews && viewItem == diffpanelArchivedRun",
          "group": "inline"
        },
        {
          "command": "diffpanel.renameReview",
          "when": "view == diffpanel.reviews && viewItem == diffpanelRun",
          "group": "0_actions"
        },
        {
          "command": "diffpanel.renameReview",
          "when": "view == diffpanel.reviews && viewItem == diffpanelArchivedRun",
          "group": "0_actions"
        },
        {
          "command": "diffpanel.openWorkingFile",
          "when": "view == diffpanel.reviews && viewItem == diffpanelItem",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "clean": "rm -rf dist coverage",
    "dev": "node esbuild.mjs --watch",
    "lint": "tsc --noEmit",
    "package": "pnpm --filter diffpanel-vscode... build && node scripts/package-extension.mjs",
    "test": "pnpm --filter diffpanel-vscode... build && vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "test:browser": "pnpm build && playwright test --config playwright.config.mjs"
  },
  "dependencies": {
    "diffpanel": "workspace:*",
    "@diffpanel/presentation": "workspace:*",
    "@diffpanel/storage": "workspace:*",
    "dompurify": "3.3.3",
    "mermaid": "11.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
