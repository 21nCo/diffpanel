{
  "name": "devroll",
  "version": "0.0.2",
  "description": "Catalog of the Devroll developer tools from 21n, such as Diffpanel and Iterbar.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/devroll.git",
    "directory": "packages/devroll"
  },
  "homepage": "https://github.com/21nCo/devroll#readme",
  "keywords": [
    "devroll",
    "developer-tools",
    "diffpanel",
    "iterbar"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
