{
  "name": "@diffpanel/storage",
  "version": "0.0.1",
  "description": "SQLite metadata and immutable content storage for Diffpanel reviews.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/diffpanel.git",
    "directory": "packages/storage"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --external better-sqlite3",
    "clean": "rm -rf dist coverage",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@diffpanel/generation": ">=0.0.1 <0.1.0",
    "diffpanel": ">=0.0.2 <0.1.0",
    "@diffpanel/git": ">=0.0.1 <0.1.0",
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
