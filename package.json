{
  "name": "diffpanel",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first, agent-generated code review chapters across editor surfaces.",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "diffpanel": "pnpm --filter @diffpanel/cli dev",
    "dev:vscode": "pnpm --filter diffpanel dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsup": "^8.5.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
