{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Diffpanel Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/apps/vscode/dist/**/*.js"
      ],
      "preLaunchTask": "Build Diffpanel"
    }
  ]
}

